        ActionBtn(s, "Find Nearest Egg", function()
            local r = GetRoot()
            if not r then
                Notify("Farm", "No character", 2)
                return
            end
            local nearest, best = nil, math.huge
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
                    local d = (obj.Position - r.Position).Magnitude
                    if d < best then best = d; nearest = obj end
                end
            end
            if nearest then
                Notify("Farm", nearest.Name .. " — " .. math.floor(best) .. " studs", 4)
            else
                Notify("Farm", "No eggs in workspace", 3)
            end
        end)

        ActionBtn(s, "Teleport to Nearest Egg", function()
            local r = GetRoot()
            if not r then return end
            local nearest, best = nil, math.huge
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
                    local d = (obj.Position - r.Position).Magnitude
                    if d < best then best = d; nearest = obj end
