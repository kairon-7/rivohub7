for _, effect in ipairs(Lighting:GetChildren()) do
    if effect:IsA("PostEffect") and effect.Enabled ~= nil then
        table.insert(state.lightingOriginal.Effects, {obj = effect, enabled = effect.Enabled})
    end
end

local function GetHumanoid()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function GetRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Notify(title, text, dur)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = dur or 3,
        })
    end)
end

local function ClearESP()
    for _, v in ipairs(state.espObjects) do
        pcall(v.Destroy, v)
    end
    state.espObjects = {}
    for _, conn in ipairs(state.espConnections) do
        pcall(conn.Disconnect, conn)
    end
    state.espConnections = {}
end

local function AddESP(adornee, color)
    if not adornee or not adornee.Parent then return end
    local h = Instance.new("Highlight")
    h.Adornee = adornee
    h.FillColor = color
    h.OutlineColor = color
    h.FillTransparency = 0.55
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = CoreGui
    table.insert(state.espObjects, h)
end

local function StopFly()
    if state.flyConn then
        state.flyConn:Disconnect()
        state.flyConn = nil
    end
    if state.flyBV then
        pcall(state.flyBV.Destroy, state.flyBV)
        state.flyBV = nil
    end
    if state.flyGyro then
        pcall(state.flyGyro.Destroy, state.flyGyro)
        state.flyGyro = nil
    end
end

local function ResetLighting()
    Lighting.Ambient = state.lightingOriginal.Ambient
    Lighting.OutdoorAmbient = state.lightingOriginal.OutdoorAmbient
    Lighting.Brightness = state.lightingOriginal.Brightness
    Lighting.GlobalShadows = state.lightingOriginal.GlobalShadows
    Lighting.FogEnd = state.lightingOriginal.FogEnd
    Lighting.FogStart = state.lightingOriginal.FogStart
    for _, data in ipairs(state.lightingOriginal.Effects) do
        pcall(function() data.obj.Enabled = data.enabled end)
    end
end

local function CleanupAll()
    ClearESP()
    StopFly()
    if state.noclipConn then
        state.noclipConn:Disconnect()
        state.noclipConn = nil
    end
    if state.infJumpConn then
        state.infJumpConn:Disconnect()
        state.infJumpConn = nil
    end
    if state.antiAfkConn then
        state.antiAfkConn:Disconnect()
        state.antiAfkConn = nil
    end
    if state.toggleConn then
        state.toggleConn:Disconnect()
        state.toggleConn = nil
    end
    if state.charAddedConn then
        state.charAddedConn:Disconnect()
        state.charAddedConn = nil
    end
    for _, conn in ipairs(state.sliderConnections) do
        pcall(conn.Disconnect, conn)
    end
    state.sliderConnections = {}
    ResetLighting()
    local h = GetHumanoid()
    if h then
        h.WalkSpeed = 16
        h.JumpPower = 50
    end
    state.walkSpeed = 16
    state.jumpPower = 50
end

local function Create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        pcall(function() obj[k] = v end)
    end
    if parent then obj.Parent = parent end
    return obj
end

local function Corner(r, parent)
    return Create("UICorner", {CornerRadius = UDim.new(0, r or 6)}, parent)
end

local function Padding(t, b, l, r, parent)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.Parent = parent
    return p
end

local function ListLayout(dir, pad, parent)
    return Create("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, pad or 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
end

local function Label(props, parent)
    local l = Create("TextLabel", {
        BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(220, 220, 220),
        Font = Enum.Font.Gotham,
        TextScaled = false,
        TextSize = 13,
        RichText = true,
    }, parent)
    for k, v in pairs(props) do
        pcall(function() l[k] = v end)
    end
    return l
end

local function Frame(props, parent)
    local f = Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(28, 28, 28),
        BorderSizePixel = 0,
    }, parent)
    for k, v in pairs(props) do
        pcall(function() f[k] = v end)
    end
    return f
end

local function Btn(props, parent, cb)
    local b = Create("TextButton", {
        BackgroundColor3 = Color3.fromRGB(35, 35, 35),
        BorderSizePixel = 0,
        TextColor3 = Color3.fromRGB(220, 220, 220),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        AutoButtonColor = false,
    }, parent)
    for k, v in pairs(props) do
        pcall(function() b[k] = v end)
    end
    if cb then
        b.MouseButton1Click:Connect(cb)
    end
    local base = b.BackgroundColor3
    b.MouseEnter:Connect(function()
        b.BackgroundColor3 = Color3.new(
            math.min(base.R + 0.08, 1),
            math.min(base.G + 0.08, 1),
            math.min(base.B + 0.08, 1)
        )
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = base
    end)
    return b
end

