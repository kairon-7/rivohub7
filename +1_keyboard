        Toggle(s, "Fly", false, function(v)
            StopFly()
            if not v then return end
            local r = GetRoot()
            if not r then
                Notify("Fly", "No character found", 2)
                return
            end

            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Velocity = Vector3.zero
            bv.Parent = r
            state.flyBV = bv

            local bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            bg.P = 1e6
            bg.Parent = r
            state.flyGyro = bg

            state.flyConn = RunService.RenderStepped:Connect(function()
                local root = GetRoot()
                if not root then
                    StopFly()
                    return
                end
                local cam = workspace.CurrentCamera
                local dir = Vector3.zero
                local spd = state.walkSpeed
                if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
                bv.Velocity = dir.Magnitude > 0 and (dir.Unit * spd) or Vector3.zero
                bg.CFrame = cam.CFrame
            end)
        end)

        Toggle(s, "Infinite Jump", false, function(v)
            if state.infJumpConn then
                state.infJumpConn:Disconnect()
                state.infJumpConn = nil
