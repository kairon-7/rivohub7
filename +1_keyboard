    local function Slider(parent, label, minV, maxV, defV, cb)
        local container = Frame({
            Size = UDim2.new(1, 0, 0, 62),
            BackgroundColor3 = BG_LIGHT,
        }, parent)
        Corner(7, container)

        Label({
            Size = UDim2.new(1, -64, 0, 26),
            Position = UDim2.new(0, 12, 0, 6),
            Text = label,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, container)

        local valLbl = Label({
            Size = UDim2.new(0, 52, 0, 26),
            Position = UDim2.new(1, -58, 0, 6),
            Text = tostring(defV),
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextColor3 = ACCENT,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, container)

        local track = Frame({
            Size = UDim2.new(1, -24, 0, 5),
            Position = UDim2.new(0, 12, 0, 44),
            BackgroundColor3 = Color3.fromRGB(45, 45, 45),
        }, container)
        Corner(3, track)

        local pct = (defV - minV) / (maxV - minV)
        local fill = Frame({
            Size = UDim2.new(pct, 0, 1, 0),
            BackgroundColor3 = ACCENT,
        }, track)
        Corner(3, fill)

        local thumb = Frame({
            Size = UDim2.new(0, 13, 0, 13),
            Position = UDim2.new(pct, -6, 0.5, -6),
            BackgroundColor3 = Color3.fromRGB(240, 240, 240),
            ZIndex = 3,
        }, track)
        Corner(7, thumb)

        local dragging = false
        local conns = {}

        local function applyX(x)
            local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local val = math.floor(minV + (maxV - minV) * rel + 0.5)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            thumb.Position = UDim2.new(rel, -6, 0.5, -6)
            valLbl.Text = tostring(val)
            cb(val)
        end

        local thumbConn = thumb.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
        end)
        table.insert(conns, thumbConn)

        local endedConn = UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        table.insert(conns, endedConn)

        local changedConn = UIS.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                applyX(i.Position.X)
            end
        end)
        table.insert(conns, changedConn)

        local trackConn = track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                applyX(i.Position.X)
            end
        end)
        table.insert(conns, trackConn)

        for _, c in ipairs(conns) do
            table.insert(state.sliderConnections, c)
        end

        cb(defV)
    end

